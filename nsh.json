{
  "name": "618player",
  "id": "com.player618.app",
  "version": "0.1.0",
  "build": 1,
  "appearance": "dark",
  "theme": "theme.json",
  "rust": ".",
  "root": "App",
  "android": {
    "permissions": [
      "android.permission.READ_MEDIA_AUDIO",
      "android.permission.READ_EXTERNAL_STORAGE",
      "android.permission.FOREGROUND_SERVICE",
      "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
    ],
    "libraries": ["android/media.jar"],
    "application": [
      "<service android:name=\"com.player618.media.PlaybackService\" android:exported=\"false\" android:foregroundServiceType=\"mediaPlayback\" />"
    ]
  }
}
